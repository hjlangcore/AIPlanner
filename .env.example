# Copy this file to .env and fill in your own values.
# Never commit .env. None of the values below are real credentials.

# Required. The API process refuses to start without these two.
LLM_API_KEY=your-llm-api-key
JWT_SECRET_KEY=replace-with-a-long-random-string

# Optional OpenAI-compatible base URL.
# backend/agent/llm_config.py leaves this unset unless you set it (or you are
# still using the legacy DASHSCOPE_API_KEY name, which fills in DashScope).
# backend/agent/agent_config.py defaults it to DashScope when unset:
# https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=

# Chat model. llm_config.py defaults this to deepseek-chat.
# agent_config.py defaults the same variable to qwen-turbo when it is unset.
# Set it explicitly so both modules use the model you intend.
LLM_MODEL=deepseek-chat

# Model used by the agent decision client in llm_config.py. Default: qwen-max
LLM2_MODEL=qwen-max

# Legacy alias for LLM_API_KEY. Prefer LLM_API_KEY.
# DASHSCOPE_API_KEY=

# Comma-separated browser origins. Default:
# http://localhost:3000,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Optional SMTP reminders. Leave blank to skip email.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=
RECEIVER_EMAIL=
